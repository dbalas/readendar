# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store

# dart-define env files may hold secrets (GOOGLE_SERVER_CLIENT_ID).
# Only env.example.json is committed; create the others from it locally.
env.dev.json
env.prod.json
env.local.json

# Fastlane / store secrets live in the sibling private folder, not here.
AuthKey_*.p8
*.p8
vendor/bundle/

# Firebase/Google config carries per-project API keys — keep out of VCS.
# Fetch from the Firebase console (or 1Password) when setting up locally.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Xcode build output (e.g. from a local `xcodebuild` of the widget extension).
ios/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Kotlin build sessions
.kotlin/
captures/

# Golden-test failure dumps (local only)
test/**/failures/
