<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug + Profile (paid team BMA8345C5L): App Groups for widgets.
	     Omits Associated Domains / Push (those still SIGKILL when absent from
	     the automatic development profile). Free-team Apple IDs: switch
	     CODE_SIGN_ENTITLEMENTS back to Runner.free-team.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.readendar.readendar</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)group.com.readendar.readendar</string>
	</array>
	<!-- Sign in with Apple so debug/profile can exercise the native sheet. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
