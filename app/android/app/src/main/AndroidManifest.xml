<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Declared explicitly rather than relying on a plugin's manifest to merge
         it in — a dependency bump must not be able to silently drop networking
         from the release build. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Camera is optional: cover selection still works through the
         system picker on devices without one. -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Voice dictation of book quotes (speech_to_text). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Readendar reads NO media store. Cover picking goes through the
         Android Photo Picker (image_picker's `useAndroidPhotoPicker`, enabled in
         lib/main.dart): the user picks one image out-of-process, the app receives
         one URI, no storage permission is involved. Every other file path
         (Goodreads CSV, Kindle clippings) goes through SAF.

         No dependency currently contributes these permissions — as of
         image_picker_android 0.8.13 none of them declare a <uses-permission> at
         all — so the merger has nothing to strip today. These markers are a
         GUARD, not a fix: they make a future plugin bump unable to silently
         re-introduce a storage permission into the merged manifest, which would
         force Play's Photo & Video Permissions declaration for access we never
         exercise. Verify with:
             app/build/app/outputs/logs/manifest-merger-release-report.txt
         If a dependency ever legitimately NEEDS one of these, the symptom is a
         runtime SecurityException, not a build failure — delete the marker then,
         don't work around it. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove"/>
    <!-- Play services may still merge Ads ID. Strip it. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <!-- Reschedule reading reminders (flutter_local_notifications) after a
         device reboot. Without this, all pending alarms are cleared on restart
         until the user next opens the app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- User-granted exact alarms for timed reading reminders. We deliberately
         avoid USE_EXACT_ALARM (a restricted Play permission): on Android 12+
         the reliability card opens the system grant screen, and scheduling
         degrades safely to inexact while permission is absent. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- android:localeConfig — per-app language picker (Android 13+). Keep
         res/xml/locales_config.xml in sync with AppL10n.supportedLocales.
         android:enableOnBackInvokedCallback — predictive back gesture. It
         defaults to true at targetSdk 36 anyway, so declaring it explicitly only
         changes the API 33–35 devices where the default is still false: there
         the Flutter embedding also routes OnBackInvoked into PopScope, so the
         behaviour is identical everywhere. -->
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- flutter_local_notifications resolves this drawable from its Dart
             string name at runtime. Keep a compiled manifest reference as well
             as res/raw/keep.xml so resource shrinking and App Bundle splitting
             cannot omit it from the installed Android base package. -->
        <meta-data
            android:name="com.readendar.notification_icon"
            android:resource="@drawable/ic_stat_readendar"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- app_links is the single deep-link owner. Without this opt-out,
                 Flutter also pushes the URI path as a named route, producing an
                 unknown-route assertion after app_links has already handled it. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Custom scheme for leftover magic-link fallback
                 (`readendar://m/<token>`) until 15 October 2026, plus widget
                 taps (`readendar://book/{id}`, `readendar://event/{id}`). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="readendar"/>
            </intent-filter>
            <!-- Share sheet → quote composer (parity with iOS Share Extension). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <!-- "Open with Readendar" for supported library CSV exports. Lets Files /
                 Drive / a mail attachment hand a .csv to the app; app_links
                 delivers the URI to source-aware ImportDeepLink routing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="content" android:mimeType="text/csv"/>
                <data android:scheme="content" android:mimeType="text/comma-separated-values"/>
                <data android:scheme="content" android:mimeType="application/csv"/>
                <data android:scheme="file" android:mimeType="text/csv"/>
            </intent-filter>
        </activity>
        <!-- flutter_local_notifications: the AlarmManager broadcast that fires a
             scheduled reminder is delivered to ScheduledNotificationReceiver,
             which posts the notification — without it, reminders never show when
             the app is closed. ScheduledNotificationBootReceiver reschedules
             pending reminders after a reboot / app update. ActionBroadcastReceiver
             receives taps on notification ACTION buttons (Complete / Snooze) that
             run in the background isolate without opening the app — the reminder
             action buttons never fire without it. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Home-screen widget (see ReadendarWidgetProvider.kt). Exported so the
             launcher can add/host it; APPWIDGET_UPDATE drives onUpdate. -->
        <receiver
            android:name=".ReadendarWidgetProvider"
            android:label="@string/widget_events_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/readendar_widget_info" />
        </receiver>
        <!-- Quotes home-screen widget (see ReadendarQuotesWidgetProvider.kt).
             Per-instance config via ReadendarQuotesConfigActivity below. -->
        <receiver
            android:name=".ReadendarQuotesWidgetProvider"
            android:label="@string/widget_quotes_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/readendar_quotes_widget_info" />
        </receiver>
        <receiver
            android:name=".ReadendarProgressWidgetProvider"
            android:label="@string/widget_progress_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/readendar_progress_widget_info" />
        </receiver>
        <!-- Launched by the OS on add (android:configure) and on long-press →
             Reconfigure (widgetFeatures="reconfigurable"). Exported with the
             CONFIGURE intent-filter per the appwidget contract. -->
        <activity
            android:name=".ReadendarQuotesConfigActivity"
            android:exported="true"
            android:theme="@style/ReadendarWidgetConfigTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
        <!-- Pre-API-31 binder for the widget's scrollable event list
             (RemoteViewsService). API 31+ embeds RemoteCollectionItems instead.
             BIND_REMOTEVIEWS restricts binding to the system, per platform reqs. -->
        <service
            android:name=".WidgetListService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />
        <!-- Dispatches taps inside the widget's event list: open the detail vs
             toggle completion (see WidgetActionReceiver). Not exported — only
             the widget's own PendingIntent template targets it. -->
        <receiver
            android:name=".WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.readendar.readendar.WIDGET_ACTION" />
            </intent-filter>
        </receiver>
        <!-- successCallback target for the one-tap "add widget" pin request
             (see MainActivity.requestPinWidget / WidgetPinReceiver). The OS
             fires this only when the user actually confirms the launcher's
             pin dialog, so it's the real completion signal the request call
             itself can't provide. -->
        <receiver
            android:name=".WidgetPinReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.readendar.readendar.ACTION_WIDGET_PINNED"/>
            </intent-filter>
        </receiver>

        <!-- image_cropper (UCrop) — banner background cropping. Required by the
             plugin so the crop screen can launch. No screenOrientation lock: the
             OS ignores orientation restrictions on screens >= 600dp at
             targetSdk 36 (tablets, unfolded foldables), so pinning portrait only
             produced a lock that held on phones and silently broke on large
             screens. UCrop's own layout handles landscape. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.Ucrop"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Allow canLaunchUrl/launchUrl to open https pages (privacy, terms)
             under Android 11+ package visibility. Without this, canLaunchUrl
             returns false and the link silently does nothing. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- speech_to_text: discover the on-device speech recognizer under
             Android 11+ package visibility (voice dictation of quotes). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
