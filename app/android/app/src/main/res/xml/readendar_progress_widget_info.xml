<?xml version="1.0" encoding="utf-8"?>
<!-- Progress widget default is a 4x3 cell so the header, book card, progress
     bar, and update CTA all fit without clipping. minResizeHeight keeps the
     2-row floor (70×n−30) so the user can still shrink it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/readendar_progress_widget"
    android:previewLayout="@layout/readendar_progress_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
