<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+). The background is the flat brand fill and
  the foreground the white calendar/bookmark mark, so launchers can mask, clip
  and parallax the two layers. `monochrome` reuses the foreground: the system
  reads only its alpha channel and tints it, which is exactly the mark's
  silhouette (Android 13+ themed icons).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
